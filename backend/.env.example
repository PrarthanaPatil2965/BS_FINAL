# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Optional overrides. Leave them alone unless a model gets deprecated.
# VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,qwen/qwen3.6-27b
# TEXT_MODELS=openai/gpt-oss-20b
# STT_MODEL=whisper-large-v3-turbo

# Alert tuning
URGENT_THRESHOLD=0.50
NOTICE_THRESHOLD=0.25
NOTICE_COOLDOWN_S=6.0
URGENT_COOLDOWN_S=2.5

# Local YOLO fast path: auto | on | off
USE_YOLO=auto
YOLO_ONNX_PATH=models/yolov8n.onnx

# Optional real SMS from the server (phone dialler is used by default)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
